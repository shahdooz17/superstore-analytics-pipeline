{
  "name": "Sales Dashboard Clean",
  "dataColors": [
    "#4E6FB5",
    "#12B5A0",
    "#F29B3C",
    "#F0674C",
    "#7F9BD6",
    "#6FCFC0",
    "#F7C384",
    "#B8C2D6"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2A44",
  "tableAccent": "#4E6FB5",
  "good": "#12B5A0",
  "neutral": "#F29B3C",
  "bad": "#F0674C",
  "maximum": "#4E6FB5",
  "center": "#F29B3C",
  "minimum": "#12B5A0",
  "null": "#B8C2D6",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2A44"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2A44"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2A44"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#6B7692"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#E3E9F2" } },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "radius": 6
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#1F2A44" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Bottom",
            "labelColor": { "solid": { "color": "#6B7692" } },
            "fontSize": 9
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#6B7692" } },
            "fontSize": 9,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#6B7692" } },
            "fontSize": 9,
            "showAxisTitle": false
          }
        ],
        "gridlineStyle": [
          {
            "show": true,
            "gridlineColor": { "solid": { "color": "#E3E9F2" } },
            "gridlineStyle": "dotted"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#1F2A44" } },
            "fontSize": 20,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#6B7692" } },
            "fontSize": 9
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "labelStyle": "Percent of total"
          }
        ]
      }
    }
  }
}